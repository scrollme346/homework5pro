{
  "name": "local-reel-editor",
  "productName": "Local Reel Editor",
  "version": "0.1.2",
  "description": "Local desktop app that turns a voice-over and labelled screen recordings into a polished vertical Reel.",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src cli scripts tests",
    "test": "vitest run",
    "gen:sfx": "tsx scripts/gen-sfx.ts",
    "cli": "tsx cli/reel.ts",
    "dist": "electron-vite build && electron-builder",
    "e2e": "electron-vite build && xvfb-run -a -s \"-screen 0 1440x900x24\" tsx tests/e2e/app.e2e.ts",
    "test:media": "tsx scripts/make-test-media.ts",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "playwright": "1.56",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "lucide-react": "^1.49.0",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snowball-stemmers": "^0.6.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "app.localreeleditor",
    "productName": "Local Reel Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "vendor/ffmpeg/${os}",
        "to": "bin",
        "filter": [
          "**/*",
          "!README.md"
        ]
      },
      {
        "from": "vendor/python/${os}",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "LocalReelEditor-Setup-${version}.exe",
      "shortcutName": "Local Reel Editor"
    },
    "publish": null
  },
  "author": "Local Reel Editor"
}
