{
  "name": "local-reel-editor",
  "productName": "Local Reel Editor",
  "version": "0.1.0",
  "description": "Local desktop app that turns a voice-over and labelled screen recordings into a polished vertical Reel.",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src cli scripts tests",
    "test": "vitest run",
    "gen:sfx": "tsx scripts/gen-sfx.ts",
    "cli": "tsx cli/reel.ts",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snowball-stemmers": "^0.6.0",
    "zustand": "^5.0.15"
  }
}
